{
  "name": "@buddy-works/visual-tests-puppeteer",
  "version": "2.0.0",
  "description": "Buddy Visual Test Puppeteer Plugin",
  "keywords": [
    "buddy",
    "buddy-works",
    "ci",
    "e2e",
    "e2e-testing",
    "image-comparison",
    "image-diff",
    "puppeteer",
    "puppeteer-plugin",
    "regression",
    "screenshot",
    "screenshot-testing",
    "test-automation",
    "testing",
    "ui-testing",
    "visual testing",
    "visual-regression",
    "visual-testing"
  ],
  "license": "MIT",
  "author": "Bartosz Wróbel",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "puppeteer": "25.8.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "puppeteer": ">=23.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
